package pages

import (
	"fmt"
	"time"
)

// WorkflowDetailData holds all data for the workflow detail page.
type WorkflowDetailData struct {
	User     string
	Workflow WorkflowData
	Jobs     []JobData
}

// WorkflowData holds workflow display data.
type WorkflowData struct {
	Name            string
	GateStatus      string
	Disabled        bool
	GatePlugin      string
	PreparePlugin   string
	DeployPlugin    string
	Model           string
	MaxFixes        int
	SourceKind      string
	SourceRepo      string
	SourceBranch    string
	WorkspaceURL    string
	WorkspaceBranch string
	LastRunAt       string
	LastCommit      string
	ToggleText      string
	TriggerDisabled bool
}

// JobData holds job display data.
type JobData struct {
	Name           string
	Status         string // succeeded | failed | running | pending
	CompletionTime string
	Duration       string
}

// WorkflowDetailPage renders a single workflow with its run history.
templ WorkflowDetailPage(data WorkflowDetailData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>harmostes — { data.Workflow.Name }</title>
		<link rel="stylesheet" href="/static/css/rezus.css">
		<link rel="stylesheet" href="/static/css/app.css">
		<script defer src="/static/js/htmx.min.js"></script>
		<script defer src="/static/js/alpine.min.js"></script>
		<script>
			(function() {
				var t = localStorage.getItem('harmostes-theme') || 'light';
				if (t === 'dark') document.documentElement.classList.add('dark');
			})();
		</script>
	</head>
	<body>
		<div class="app-layout">
			<aside class="ds-sidebar">
				<div class="ds-sidebar-header">
					<div class="ds-sidebar-logo">
						<span class="ds-sidebar-logo-text">harmostes</span>
					</div>
				</div>
				<nav class="ds-sidebar-nav">
					<a href="/workflows" class="ds-sidebar-link">
						<svg class="ds-sidebar-icon" viewBox="0 0 16 16" fill="currentColor">
							<path d="M1 3h14v2H1V3zm0 4h14v2H1V7zm0 4h14v2H1v-2z"></path>
						</svg>
						Workflows
					</a>
					<a href="/pipelines" class="ds-sidebar-link">
						<svg class="ds-sidebar-icon" viewBox="0 0 16 16" fill="currentColor">
							<circle cx="4" cy="4" r="2"></circle>
							<circle cx="12" cy="4" r="2"></circle>
							<circle cx="8" cy="12" r="2"></circle>
							<path d="M5.5 5.5L7 10M10.5 5.5L9 10" stroke="currentColor" fill="none"></path>
						</svg>
						Pipelines
					</a>
					<a href="/tokens" class="ds-sidebar-link">
						<svg class="ds-sidebar-icon" viewBox="0 0 16 16" fill="currentColor">
							<path d="M8 1a3 3 0 00-3 3v2H4a1 1 0 00-1 1v6a1 1 0 001 1h8a1 1 0 001-1V7a1 1 0 00-1-1h-1V4a3 3 0 00-3-3zm-1 3a1 1 0 112 0v2H7V4z"></path>
						</svg>
						Tokens
					</a>
				</nav>
				<div class="ds-sidebar-footer">
					<span class="ds-sidebar-version">v0.24.0-dev</span>
				</div>
			</aside>

			<main class="ds-main">
				<header class="ds-header">
					<div class="ds-header-title">
						<a href="/workflows" class="ds-header-back">&larr; Workflows</a>
						<h1>{ data.Workflow.Name }</h1>
					</div>
					<div class="ds-header-user">
						<span class="ds-user-badge">{ data.User }</span>
					</div>
				</header>

				<div class="ds-content">
					<!-- Status and actions -->
					<div class="wf-detail-header">
						<div class="wf-detail-status">
							if data.Workflow.Disabled {
								<span class="ds-badge ds-badge--neutral">Disabled</span>
							} else if data.Workflow.GateStatus == "green" {
								<span class="ds-badge ds-badge--success">Green</span>
							} else if data.Workflow.GateStatus == "failed" {
								<span class="ds-badge ds-badge--danger">Failed</span>
							} else {
								<span class="ds-badge ds-badge--neutral">Unknown</span>
							}
						</div>
						<div class="wf-detail-actions">
							<a href={ "/workflows/" + data.Workflow.Name + "/canvas" } class="ds-button ds-button--secondary">
								📊 Canvas
							</a>
							if data.Workflow.TriggerDisabled {
								<button disabled class="ds-button ds-button--secondary">Trigger Run</button>
							} else {
								<button class="ds-button ds-button--primary">Trigger Run</button>
							}
							<button class="ds-button ds-button--secondary">{ data.Workflow.ToggleText }</button>
							<button class="ds-button ds-button--danger">Delete</button>
						</div>
					</div>

					<!-- Pipeline config -->
					<div class="wf-detail-section">
						<h2>Pipeline</h2>
						<div class="wf-detail-grid">
							<div class="wf-detail-item">
								<span class="wf-detail-label">Prepare</span>
								<span class="wf-detail-value">{ data.Workflow.PreparePlugin }</span>
							</div>
							<div class="wf-detail-item">
								<span class="wf-detail-label">Gate</span>
								<span class="wf-detail-value">{ data.Workflow.GatePlugin }</span>
							</div>
							<div class="wf-detail-item">
								<span class="wf-detail-label">Deploy</span>
								<span class="wf-detail-value">{ data.Workflow.DeployPlugin }</span>
							</div>
							if data.Workflow.Model != "" {
								<div class="wf-detail-item">
									<span class="wf-detail-label">Model</span>
									<span class="wf-detail-value">{ data.Workflow.Model }</span>
								</div>
							}
							if data.Workflow.MaxFixes > 0 {
								<div class="wf-detail-item">
									<span class="wf-detail-label">Max Fixes</span>
									<span class="wf-detail-value">{ fmt.Sprintf("%d", data.Workflow.MaxFixes) }</span>
								</div>
							}
						</div>
					</div>

					<!-- Source -->
					<div class="wf-detail-section">
						<h2>Source</h2>
						<div class="wf-detail-grid">
							<div class="wf-detail-item">
								<span class="wf-detail-label">Kind</span>
								<span class="wf-detail-value">{ data.Workflow.SourceKind }</span>
							</div>
							if data.Workflow.SourceRepo != "" {
								<div class="wf-detail-item">
									<span class="wf-detail-label">Repo</span>
									<span class="wf-detail-value">{ data.Workflow.SourceRepo }</span>
								</div>
							}
							if data.Workflow.SourceBranch != "" {
								<div class="wf-detail-item">
									<span class="wf-detail-label">Branch</span>
									<span class="wf-detail-value">{ data.Workflow.SourceBranch }</span>
								</div>
							}
							if data.Workflow.WorkspaceURL != "" {
								<div class="wf-detail-item">
									<span class="wf-detail-label">Workspace URL</span>
									<span class="wf-detail-value">{ data.Workflow.WorkspaceURL }</span>
								</div>
							}
							if data.Workflow.WorkspaceBranch != "" {
								<div class="wf-detail-item">
									<span class="wf-detail-label">Workspace Branch</span>
									<span class="wf-detail-value">{ data.Workflow.WorkspaceBranch }</span>
								</div>
							}
						</div>
					</div>

					<!-- Status -->
					<div class="wf-detail-section">
						<h2>Status</h2>
						<div class="wf-detail-grid">
							<div class="wf-detail-item">
								<span class="wf-detail-label">Gate</span>
								<span class="wf-detail-value">{ data.Workflow.GateStatus }</span>
							</div>
							<div class="wf-detail-item">
								<span class="wf-detail-label">Last Run</span>
								<span class="wf-detail-value">{ data.Workflow.LastRunAt }</span>
							</div>
							<div class="wf-detail-item">
								<span class="wf-detail-label">Last Commit</span>
								<span class="wf-detail-value">{ data.Workflow.LastCommit }</span>
							</div>
						</div>
					</div>

					<!-- Run history -->
					<div class="wf-detail-section">
						<h2>Run History</h2>
						if len(data.Jobs) == 0 {
							<p class="wf-empty-runs">No runs recorded.</p>
						} else {
							<ul class="wf-run-list">
								for _, job := range data.Jobs {
									<li class="wf-run-item">
										if job.Status == "succeeded" {
											<span class="wf-run-dot wf-run-dot--ok"></span>
										} else if job.Status == "failed" {
											<span class="wf-run-dot wf-run-dot--fail"></span>
										} else {
											<span class="wf-run-dot wf-run-dot--skip"></span>
										}
										<a href={ "/workflows/" + data.Workflow.Name + "/runs/" + job.Name } class="wf-run-info">
											{ job.Name }
											if job.CompletionTime != "" {
												— { job.CompletionTime }
											}
										</a>
										if job.Duration != "" {
											<span class="wf-run-time">{ job.Duration }</span>
										}
									</li>
								}
							</ul>
						}
					</div>
				</div>
			</main>
		</div>
	</body>
	</html>
}

// formatDuration formats a time.Duration as a string.
func formatDuration(d time.Duration) string {
	if d < time.Minute {
		return fmt.Sprintf("%.1fs", d.Seconds())
	}
	if d < time.Hour {
		return fmt.Sprintf("%.1fm", d.Minutes())
	}
	return fmt.Sprintf("%.1fh", d.Hours())
}

// toggleText returns "Enable" for disabled workflows, "Disable" otherwise.
func toggleText(disabled bool) string {
	if disabled {
		return "Enable"
	}
	return "Disable"
}