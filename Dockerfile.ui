# Dockerfile.ui — harmostes-ui: observability-first web interface.
# Two stages: Go (binary build, embeds CSS/JS via go:embed) → distroless (runtime).
# No Node.js build step — the UI is server-rendered Go templates + HTMX.

# ---------------------------------------------------------------------------
# Stage 1: Build the Go binary
# ---------------------------------------------------------------------------
FROM golang:1.25-bookworm AS builder

WORKDIR /src

# Cache deps
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X main.version=$(git describe --tags --always 2>/dev/null || echo dev)" \
    -o /out/harmostes-ui \
    ./cmd/harmostes-ui/

# ---------------------------------------------------------------------------
# Stage 2: Distroless runtime
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/harmostes-ui /harmostes-ui

USER nonroot
ENTRYPOINT ["/harmostes-ui"]
