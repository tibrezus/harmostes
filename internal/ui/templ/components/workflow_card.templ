package components

// WorkflowCard — displays a workflow in a list.
// Data: { Name string, Gate string, Disabled bool, LastRunAt string }
templ WorkflowCard(name string, gate string, disabled bool, lastRunAt string) {
	<a href={ "/workflows/" + name } class="wf-card" :class="{ 'wf-card--disabled': { disabled } }">
		<div class="wf-card-header">
			<span class="wf-card-name">{ name }</span>
			<span class="wf-card-status">
				if disabled {
					<span class="ds-badge ds-badge--neutral">Disabled</span>
				} else {
					<span class="ds-badge ds-badge--success">Running</span>
				}
			</span>
		</div>
		<div class="wf-card-body">
			<div class="wf-card-gate">
				<span class="wf-card-label">Gate:</span>
				<span class="wf-card-value">{ gate }</span>
			</div>
			<div class="wf-card-last-run">
				<span class="wf-card-label">Last run:</span>
				<span class="wf-card-value">{ lastRunAt }</span>
			</div>
		</div>
	</a>
}