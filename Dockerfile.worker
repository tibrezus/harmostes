# harmostes-worker — the generic worker image (Go runtime, no Python runtime).
#
# Multi-stage: build the Go worker binary, drop it into a base that carries pi
# (Node) + git + the plugin runtime (sh). Plugins are bash/python SCRIPTS or
# their own images; the framework runtime itself is Go only.
#
# The worker runs the prepare / agent / deploy phases for any Workflow CR:
#   - prepare/deploy: invoke the phase's plugin (image or ConfigMap script) with
#     the HARMOSTES_* contract (see the wiki Plugin Interface page).
#   - agent: run the Go harmostes primitive (internal/agent) — spawn pi --mode rpc,
#     task → gate → feedback-as-warm-session-continuation.
#
# Build: make docker TAG=0.1.0   (or: docker build -t ... -f Dockerfile.worker .)

# --- stage 1: build the Go worker binary ---
# Go 1.25: the OTel SDK (internal/observability, Phase 1) requires it.
FROM golang:1.25-bookworm AS build
WORKDIR /src
ENV GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# CGO disabled for a static binary that drops into a slim base.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/harmostes-worker ./cmd/harmostes-worker \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/harmostes-agent  ./cmd/harmostes-agent

# --- stage 2: runtime (Node for pi + minimal system tools) ---
FROM node:22-bookworm-slim
# System tools a plugin is likely to need (git is universal; curl/jq/yq for
# state access; ca-certs for HTTPS). The Debian base ships python3 — that is
# intentional: PLUGINS may be python scripts (the contract permits scripts in any
# language). The framework RUNTIME itself is Go-only (harmostes-worker / -agent);
# no framework code runs under python. Plugins that need a heavier runtime ship as
# their own image (spec.<phase>.plugin.image).
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates curl jq yq bash openssh-client xz-utils \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# pi.dev harness (the only non-Go runtime — Node, the agent's tool host)
# Pinned by hand, deliberately: the rig-query load gate is the version's
# acceptance test, so an auto-bump that passes CI without rebuilding the
# image is worse than a conscious bump (#338 r20).
ARG PI_VERSION=0.84.4
RUN npm install -g @earendil-works/pi-coding-agent@${PI_VERSION}

# Lint tools — the wiki-lint gate runs the wiki's full ci-lint.sh (markdownlint,
# mdlint, remark, mermaid render via Chromium, likec4, health, RIG compliance).
# Pre-installed so the gate's install_all_lint_tools is a no-op (fast).
# apt FIRST: mermaid-cli's postinstall (puppeteer Chrome) needs unzip.
RUN apt-get update && apt-get install -y --no-install-recommends \
        unzip python3-pip libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libxkbcommon0 \
        libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
        libpango-1.0-0 libcairo2 libasound2 fonts-liberation \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && npm install -g markdownlint-cli2 @mermaid-js/mermaid-cli likec4 \
    && npx -y puppeteer browsers install chrome \
    && python3 -m pip install --no-cache-dir --break-system-packages pyyaml mdlint-obsidian

# Go (for emit-rig's go-modules extractor) + Zig (for emit-rig's zig-build extractor).
COPY --from=build /usr/local/go /usr/local/go
ENV GOPATH=/go PATH=/usr/local/go/bin:/go/bin:${PATH}
RUN mkdir -p /go

# Zig — emit-rig.py zig-build extractor scans build.zig + .zig sources and
# runs `zig version` for build-system evidence.
# metadata, but never `zig build` (parse-only). Any stable version suffices.
ARG ZIG_VERSION=0.14.0
RUN curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-x86_64-${ZIG_VERSION}.tar.xz" \
        -o /tmp/zig.tar.xz \
    && tar -xf /tmp/zig.tar.xz -C /usr/local \
    && ln -s "/usr/local/zig-linux-x86_64-${ZIG_VERSION}/zig" /usr/local/bin/zig \
    && rm /tmp/zig.tar.xz \
    && zig version

# GitHub CLI — for platform wiki offloading (push low-level details to the
# project's GitHub wiki via `gh api` or `git clone <repo>.wiki.git`).
ARG GH_VERSION=2.63.2
RUN curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
        -o /tmp/gh.tar.gz \
    && tar -xzf /tmp/gh.tar.gz -C /tmp \
    && mv "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh*

# The framework binaries
COPY --from=build /out/harmostes-worker /usr/local/bin/harmostes-worker
COPY --from=build /out/harmostes-agent  /usr/local/bin/harmostes-agent


# fj CLI — the rezuscloud fork's client, used by the review agents for
# forgejo-hosted PR threads (comments/replies). Pinned to the fork's
# release channel. rezus.2 ships typed single-comment flags
# (`fj review create|comment|submit`, closes upstream #109); our batched
# comments[] reviews intentionally stay on the raw --body path (array
# kinds are out of the flag binder's scope by design).
# KEEP IN SYNC: this block is duplicated in .github/Dockerfile.worker.release.
ARG TARGETARCH
RUN curl -fsSL "https://github.com/rezuscloud/forgejo/releases/download/v16.0.3-rezus.2/fj-linux-${TARGETARCH}.tar.gz" -o /tmp/fj.tgz \
    && curl -fsSL "https://github.com/rezuscloud/forgejo/releases/download/v16.0.3-rezus.2/checksums.txt" -o /tmp/fj.sha \
    && grep "fj-linux-${TARGETARCH}.tar.gz$" /tmp/fj.sha | sed "s#  .*#  /tmp/fj.tgz#" | sha256sum -c - \
    && mkdir -p /tmp/fjx && tar -xzf /tmp/fj.tgz -C /tmp/fjx \
    && F="$(find /tmp/fjx -type f -name 'fj-linux-*')" && [ "$(printf '%s\n' "$F" | wc -l)" = "1" ] \
    && install -m 0755 "$F" /usr/local/bin/fj \
    && rm -rf /tmp/fjx /tmp/fj.tgz /tmp/fj.sha && fj version

# Built-in plugins shipped in the image (ConfigMap plugins mount under /plugins)
# ADR-0011: every production plugin is a built-in — workspace/pr-review/
# post-review (the pr-review pipeline) and fork-sync (the fork-maintenance
# engine entry point; its payload rides in the chart as ConfigMaps mounted at
# /workspace). k8s-config carries no plugin scripts.
COPY plugins/noop/noop.sh      /usr/local/lib/harmostes/plugins/noop.sh
COPY plugins/rig-emit/rig-emit.sh  /usr/local/lib/harmostes/plugins/rig-emit.sh
COPY plugins/rig-emit/rig        /usr/local/lib/harmostes/plugins/rig
COPY plugins/rig-emit/emit-rig.py  /usr/local/lib/harmostes/plugins/emit-rig.py
COPY plugins/rig-emit/emit-rig.sh  /usr/local/lib/harmostes/plugins/emit-rig.sh
COPY plugins/rig-emit/rig-to-c4.py /usr/local/lib/harmostes/plugins/rig-to-c4.py
COPY plugins/wiki-lint/wiki-lint.sh /usr/local/lib/harmostes/plugins/wiki-lint.sh
COPY plugins/git-push/git-push.sh   /usr/local/lib/harmostes/plugins/git-push.sh
COPY plugins/workspace/workspace.sh   /usr/local/lib/harmostes/plugins/workspace.sh
COPY plugins/lib/                     /usr/local/lib/harmostes/lib/
COPY plugins/pr-review/pr-review.sh   /usr/local/lib/harmostes/plugins/pr-review.sh
COPY plugins/post-review/post-review.sh /usr/local/lib/harmostes/plugins/post-review.sh
COPY plugins/fork-sync/fork-sync.sh   /usr/local/lib/harmostes/plugins/fork-sync.sh
RUN chmod +x /usr/local/lib/harmostes/plugins/*.sh

# Git identity — the agent commits its own work; this ensures every commit (the
# agent's AND the git-push plugin's) is authored by harmostes-bot.
RUN git config --global user.name 'harmostes-bot' && \
    git config --global user.email 'harmostes-bot@harmostes.dev' && \
    git config --global --add safe.directory '*'

# Skills are NOT baked into the image — the controller injects an init
# container that clones the agents repo (source of truth) into /skills at
# runtime, so every worker pod gets the latest skills without an image rebuild.
# The .agents submodule in the repo is for local dev only.

# pi extensions:
# - litellm-provider: registers the litellm/* model prefix from LITELLM_URL +
#   LITELLM_API_KEY env vars injected by the controller
# - rig-query: architecture-graph navigation tool over rig.db (ADR-0009,
#   #337) — degrades gracefully when prepare emitted no graph
# - pi-searxng: web search + content fetch (for pr-review's selective
#   best-practice/CVE lookup). Auto-discovered via settings.json packages.
COPY extensions/litellm-provider /extensions/litellm-provider
COPY extensions/rig-query        /extensions/rig-query
# Startup smoke gate (r17 M12 / r20 driver 3): pi exits 1 when the extension
# fails to PARSE, THROWS at load, or the -e path is missing — a non-zero rc
# fails the build. Typebox itself resolves through pi's alias injection
# (guaranteed by the pinned PI_VERSION below), which is why unresolvable-
# dependency failures are covered by the TS tier, not this probe.
RUN PI_SKIP_VERSION_CHECK=1 timeout 60 pi -e /extensions/rig-query --mode rpc </dev/null >/tmp/pi-load.log 2>&1; rc=$?; \
    if [ $rc -ne 0 ]; then \
      echo "rig-query load probe failed (pi exit $rc):"; cat /tmp/pi-load.log; exit 1; \
    fi
# litellm-provider load probe (#359 pillar 8): same parse/load gate. The stub
# URL makes the /v1/models fetch fail fast, exercising the extension's
# graceful early-return — pi must still exit 0 (a parse or load-time throw
# would not).
RUN LITELLM_URL=http://127.0.0.1:1 LITELLM_API_KEY=stub PI_SKIP_VERSION_CHECK=1 timeout 60 pi -e /extensions/litellm-provider --mode rpc </dev/null >/tmp/pi-litellm-load.log 2>&1; rc=$?; \
    if [ $rc -ne 0 ]; then \
      echo "litellm-provider load probe failed (pi exit $rc):"; cat /tmp/pi-litellm-load.log; exit 1; \
    fi
# sol-pi (#425): NVIDIA's standalone efficiency extension for pi (action
# fusion + observation pack in the shipped default config; reducer/compact
# OFF — see the config rationale in the issue). Pinned by SHA, deliberately:
# an unpinned clone drifts on every rebuild, and the extension wraps the
# agents' built-in edit/write/bash tools — its behavior is part of the
# image's contract. The compat story: SoL-Pi tests against pi 0.84.2, peer
# deps are `*`; the load probe below + the upstream suite (132/134 vs npm-12
# pack-output parsing, env-only) are the 0.84.4 acceptance.
ARG SOL_PI_REF=22277b7e0c3c46ba1259a6687f31fe39ade421a5
RUN git clone --quiet https://github.com/NVlabs/SoL-Pi /tmp/sol-pi \
    && git -C /tmp/sol-pi checkout --quiet ${SOL_PI_REF} \
    && mkdir -p /extensions/sol-pi \
    && cp -a /tmp/sol-pi/. /extensions/sol-pi/ \
    && rm -rf /extensions/sol-pi/.git /tmp/sol-pi
# Shipped default config (#425): the README's conservative profile — local,
# model-call-free mechanisms only. EPR is OFF: it would send repo diagnostic
# logs to a reducer model; online-context-compact is OFF: its
# abort/compact/continue flow would interact with the review gate's turn
# structure. Validated at build time with SoL-Pi's own schema check.
RUN mkdir -p /root/.pi/agent && printf '%s\n' \
    '{' \
    '  "version": 1,' \
    '  "actionFusion": true,' \
    '  "observationPack": true,' \
    '  "evidencePreservingReducer": false,' \
    '  "onlineContextCompact": false,' \
    '  "cacheWriteReadRatio": 12.5' \
    '}' > /root/.pi/agent/sol-pi.json \
    && node /extensions/sol-pi/scripts/check-sol-pi-config.mjs --config /root/.pi/agent/sol-pi.json \
    || { echo "sol-pi config check failed"; exit 1; }
# sol-pi load probe (#425): same gate as the probes above — pi must exit 0
# with the extension loaded (all mechanisms register at session_start, so a
# parse/load-time throw is what this catches; the config above governs the rest).
RUN PI_SKIP_VERSION_CHECK=1 timeout 60 pi -e /extensions/sol-pi --mode rpc </dev/null >/tmp/pi-solpi-load.log 2>&1; rc=$?; \
    if [ $rc -ne 0 ]; then \
      echo "sol-pi load probe failed (pi exit $rc):"; cat /tmp/pi-solpi-load.log; exit 1; \
    fi
RUN pi install npm:pi-searxng
# pi settings: auto-load the searxng extension on every pi invocation
RUN mkdir -p /root/.pi/agent && \
    echo '{"packages":["npm:pi-searxng"]}' > /root/.pi/agent/settings.json
# SearXNG instance in the cluster (searxng namespace)
ENV SEARXNG_URL=http://searxng.searxng.svc.cluster.local:8080

# Where the plugin contract expects them to run + read/write
WORKDIR /workspace

# harmostes-worker is the entrypoint; it reads its phase + Workflow from env
# (HARMOSTES_WORKFLOW, HARMOSTES_NAMESPACE, HARMOSTES_PHASE, …) and the in-cluster
# config (Dapr sidecar at localhost:3500).
ENTRYPOINT ["/usr/local/bin/harmostes-worker"]
