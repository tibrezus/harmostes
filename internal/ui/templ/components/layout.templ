package components

// Layout — base layout template for harmostes-ui.
// Data: { PageKey string, Page string, User string, Content template.HTML }
templ Layout(pageKey string, pageTitle string, user string, content template.HTML) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>harmostes — { pageTitle }</title>
		<link rel="stylesheet" href="/static/css/rezus.css">
		<link rel="stylesheet" href="/static/css/app.css">
		<script defer src="/static/js/htmx.min.js"></script>
		<script defer src="/static/js/htmx-sse.js"></script>
		<script defer src="/static/js/alpine.min.js"></script>
		<script>
			// Apply theme before paint to avoid flash.
			(function() {
				var t = localStorage.getItem('harmostes-theme') || 'light';
				if (t === 'dark') document.documentElement.classList.add('dark');
			})();
		</script>
	</head>
	<body>
		<div class="app-layout">
			<!-- Sidebar -->
			<aside class="ds-sidebar">
				<div class="ds-sidebar-header">
					<div class="ds-sidebar-logo">
						<span class="ds-sidebar-logo-text">harmostes</span>
					</div>
				</div>
				<nav class="ds-sidebar-nav" aria-label="Main navigation">
					<a href="/workflows" class="ds-sidebar-link" :class="{ 'ds-sidebar-link--active': currentPage === 'workflows' }" x-data="{ currentPage: '{ pageKey }' }">
						<svg class="ds-sidebar-icon" viewBox="0 0 16 16" fill="currentColor">
							<path d="M1 3h14v2H1V3zm0 4h14v2H1V7zm0 4h14v2H1v-2z"></path>
						</svg>
						Workflows
					</a>
					<a href="/pipelines" class="ds-sidebar-link" :class="{ 'ds-sidebar-link--active': currentPage === 'pipelines' }">
						<svg class="ds-sidebar-icon" viewBox="0 0 16 16" fill="currentColor">
							<circle cx="4" cy="4" r="2"></circle>
							<circle cx="12" cy="4" r="2"></circle>
							<circle cx="8" cy="12" r="2"></circle>
							<path d="M5.5 5.5L7 10M10.5 5.5L9 10" stroke="currentColor" fill="none"></path>
						</svg>
						Pipelines
					</a>
					<a href="/tokens" class="ds-sidebar-link" :class="{ 'ds-sidebar-link--active': currentPage === 'tokens' }">
						<svg class="ds-sidebar-icon" viewBox="0 0 16 16" fill="currentColor">
							<path d="M8 1a3 3 0 00-3 3v2H4a1 1 0 00-1 1v6a1 1 0 001 1h8a1 1 0 001-1V7a1 1 0 00-1-1h-1V4a3 3 0 00-3-3zm-1 3a1 1 0 112 0v2H7V4z"></path>
						</svg>
						Tokens
					</a>
				</nav>
				<div class="ds-sidebar-footer">
					<span class="ds-sidebar-version">v0.24.0-dev</span>
				</div>
			</aside>

			<!-- Main content -->
			<main class="ds-main">
				<header class="ds-header">
					<div class="ds-header-title">
						<h1>{ pageTitle }</h1>
					</div>
					<div class="ds-header-user">
						<span class="ds-user-badge">{ user }</span>
					</div>
				</header>
				<div class="ds-content">
					<!-- Page content injected here -->
					{ content }
				</div>
			</main>
		</div>
	</body>
	</html>
}