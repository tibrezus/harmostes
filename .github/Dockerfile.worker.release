# Release Dockerfile for harmostes-worker.
#
# GoReleaser pre-builds the Go binaries (harmostes-worker + harmostes-agent).
# This image carries the full runtime: Node.js (pi.dev host), lint tools,
# Go toolchain (emit-rig extractor), Zig, gh CLI, built-in plugins.
#
# Mirrors Dockerfile.worker stage 2 but with binaries COPY'd from GoReleaser
# instead of built in a multi-stage Go stage. Single-platform: linux/amd64.
FROM node:22-bookworm-slim

ARG TARGETPLATFORM=linux/amd64

# System tools plugins are likely to need.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates curl jq yq bash openssh-client xz-utils \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# pi.dev harness (the only non-Go runtime — Node, the agent's tool host)
# Pinned by hand, deliberately: the rig-query load gate is the version's
# acceptance test, so an auto-bump that passes CI without rebuilding the
# image is worse than a conscious bump (#338 r20).
ARG PI_VERSION=0.84.4
RUN npm install -g @earendil-works/pi-coding-agent@${PI_VERSION}

# Lint tools — wiki-lint gate runs ci-lint.sh (markdownlint, remark,
# mermaid via Chromium, likec4). Pre-installed for speed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        unzip python3-pip libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libxkbcommon0 \
        libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
        libpango-1.0-0 libcairo2 libasound2 fonts-liberation \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && npm install -g markdownlint-cli2 @mermaid-js/mermaid-cli likec4 \
    && npx -y puppeteer browsers install chrome \
    && python3 -m pip install --no-cache-dir --break-system-packages pyyaml mdlint-obsidian

# Go toolchain (for emit-rig's go-modules extractor — runs `go list`).
ARG GO_VERSION=1.25.0
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
        -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV GOPATH=/go PATH=/usr/local/go/bin:/go/bin:${PATH}
RUN mkdir -p /go

# Zig — emit-rig.py zig-build extractor.
ARG ZIG_VERSION=0.14.0
RUN curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-x86_64-${ZIG_VERSION}.tar.xz" \
        -o /tmp/zig.tar.xz \
    && tar -xf /tmp/zig.tar.xz -C /usr/local \
    && ln -s "/usr/local/zig-linux-x86_64-${ZIG_VERSION}/zig" /usr/local/bin/zig \
    && rm /tmp/zig.tar.xz \
    && zig version

# GitHub CLI — platform wiki offloading.
ARG GH_VERSION=2.63.2
RUN curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
        -o /tmp/gh.tar.gz \
    && tar -xzf /tmp/gh.tar.gz -C /tmp \
    && mv "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh*

# Framework binaries (pre-built by GoReleaser).
COPY ${TARGETPLATFORM}/harmostes-worker /usr/local/bin/harmostes-worker
COPY ${TARGETPLATFORM}/harmostes-agent  /usr/local/bin/harmostes-agent


# fj CLI — the rezuscloud fork's client, used by the review agents for
# forgejo-hosted PR threads (comments/replies). Pinned to the fork's
# release channel. rezus.2 ships typed single-comment flags
# (`fj review create|comment|submit`, closes upstream #109); our batched
# comments[] reviews intentionally stay on the raw --body path (array
# kinds are out of the flag binder's scope by design).
# KEEP IN SYNC: this block is duplicated in .github/Dockerfile.worker.release.
ARG TARGETARCH
RUN curl -fsSL "https://github.com/rezuscloud/forgejo/releases/download/v16.0.3-rezus.2/fj-linux-${TARGETARCH}.tar.gz" -o /tmp/fj.tgz \
    && curl -fsSL "https://github.com/rezuscloud/forgejo/releases/download/v16.0.3-rezus.2/checksums.txt" -o /tmp/fj.sha \
    && grep "fj-linux-${TARGETARCH}.tar.gz$" /tmp/fj.sha | sed "s#  .*#  /tmp/fj.tgz#" | sha256sum -c - \
    && mkdir -p /tmp/fjx && tar -xzf /tmp/fj.tgz -C /tmp/fjx \
    && F="$(find /tmp/fjx -type f -name 'fj-linux-*')" && [ "$(printf '%s\n' "$F" | wc -l)" = "1" ] \
    && install -m 0755 "$F" /usr/local/bin/fj \
    && rm -rf /tmp/fjx /tmp/fj.tgz /tmp/fj.sha && fj version

# Built-in plugins shipped in the image.
COPY plugins/noop/noop.sh          /usr/local/lib/harmostes/plugins/noop.sh
COPY plugins/rig-emit/rig-emit.sh  /usr/local/lib/harmostes/plugins/rig-emit.sh
COPY plugins/rig-emit/rig          /usr/local/lib/harmostes/plugins/rig
COPY plugins/rig-emit/emit-rig.py  /usr/local/lib/harmostes/plugins/emit-rig.py
COPY plugins/rig-emit/emit-rig.sh  /usr/local/lib/harmostes/plugins/emit-rig.sh
COPY plugins/rig-emit/rig-to-c4.py /usr/local/lib/harmostes/plugins/rig-to-c4.py
COPY plugins/wiki-lint/wiki-lint.sh /usr/local/lib/harmostes/plugins/wiki-lint.sh
COPY plugins/git-push/git-push.sh   /usr/local/lib/harmostes/plugins/git-push.sh
COPY plugins/workspace/workspace.sh      /usr/local/lib/harmostes/plugins/workspace.sh
COPY plugins/lib/                        /usr/local/lib/harmostes/lib/
COPY plugins/pr-review/pr-review.sh      /usr/local/lib/harmostes/plugins/pr-review.sh
COPY plugins/post-review/post-review.sh  /usr/local/lib/harmostes/plugins/post-review.sh
COPY plugins/fork-sync/fork-sync.sh      /usr/local/lib/harmostes/plugins/fork-sync.sh
RUN chmod +x /usr/local/lib/harmostes/plugins/*.sh

# Git identity — the agent commits its own work.
RUN git config --global user.name 'harmostes-bot' && \
    git config --global user.email 'harmostes-bot@harmostes.dev' && \
    git config --global --add safe.directory '*'

# pi extensions.
COPY extensions/litellm-provider /extensions/litellm-provider
COPY extensions/rig-query        /extensions/rig-query
RUN pi install npm:pi-searxng
# defaultProjectTrust=never (#426 r3 finding 1): review workspaces are
# UNTRUSTED PR content — a repo shipping .pi/sol-pi.json must not be able to
# flip the harness's own config (evidencePreservingReducer=true would ship
# repo diagnostic logs to a remote reducer model) or load project .pi/
# resources at all. The shipped /root/.pi/agent/sol-pi.json is therefore THE
# effective profile on every agent run.
# sol-pi (#425): NVIDIA's standalone efficiency extension for pi, VENDORED
# at extensions/sol-pi (provenance, ownership constraints, bump protocol:
# extensions/sol-pi/UPSTREAM.md). The shipped profile
# (extensions/sol-pi/sol-pi.json — the ONE copy in the tree) is the
# conservative set: actionFusion + observationPack are local and make no
# model calls; evidencePreservingReducer is OFF (it would ship repo
# diagnostic logs to a remote reducer model) and onlineContextCompact is
# OFF (its abort/compact/continue flow would interact with the review
# gate's turn structure).
#
# Gates, in order — every one wired to the build's exit status (r7: a
# `; `-chained RUN only decides on its LAST command, so each arm carries
# its own failure exit):
#   1. schema + effectiveness: SoL-Pi's own checker parses the shipped
#      profile and an assertion requires the conservative flags to be LIVE
#      (fusion+pack on, reducer+compact off) — parseability is not enough;
#   2. load probe: pi must start with the extension and emit NO
#      extension_error event (a session_start throw exits 0 on pi's side —
#      rc alone ships inert extensions green). The count-form also fails
#      loudly if pi renames the event (grep -c returns 0).
#   3. two-arm TRUST GATE, pi-mediated (a bare `node` import of the
#      vendored config.ts cannot resolve @earendil-works/* here, and a
#      probe passing its own allowProjectConfig value tests a parameter
#      production never supplies — r6 probe reproduced both). The probe
#      extension resolves the effective config via pi's REAL
#      isProjectTrusted() and emits one JSON line on stderr:
#        arm 1 (--no-approve — the fleet's invariant, emitted by
#          buildPiArgs on every invocation): a .pi/sol-pi.json-only
#          workspace must NOT enable the reducer;
#        arm 2 (no flag): the same workspace MUST enable it — pi 0.84.4
#          auto-trusts .pi/sol-pi.json-only workspaces before
#          defaultProjectTrust is consulted (reviewer-probed), proving the
#          probe is sensitive and the flag is load-bearing.
COPY extensions/sol-pi /extensions/sol-pi
COPY extensions/sol-pi/sol-pi.json /root/.pi/agent/sol-pi.json
COPY extensions/sol-pi/settings.json /root/.pi/agent/settings.json
RUN node /extensions/sol-pi/scripts/check-sol-pi-config.mjs --config /root/.pi/agent/sol-pi.json > /tmp/sol-pi-config.json \
    && node -e 'const c=JSON.parse(require("fs").readFileSync("/tmp/sol-pi-config.json","utf8"));const e=c.effective_config||c;if(!e.actionFusion||!e.observationPack||e.evidencePreservingReducer!==false||e.onlineContextCompact!==false){console.error("sol-pi profile drift:",JSON.stringify(e));process.exit(1)}' \
    || { echo "sol-pi config/profile check failed"; cat /tmp/sol-pi-config.json 2>/dev/null; exit 1; }
RUN PI_SKIP_VERSION_CHECK=1 timeout 60 pi -e /extensions/sol-pi --mode rpc </dev/null >/tmp/pi-solpi-load.log 2>&1; rc=$?; \
    head -5 /tmp/pi-solpi-load.log; \
    if [ $rc -ne 0 ]; then \
      echo "sol-pi load probe failed (pi exit $rc):"; cat /tmp/pi-solpi-load.log; exit 1; \
    fi; \
    n=$(grep -c '"type":"extension_error"' /tmp/pi-solpi-load.log || true); \
    if [ "$n" != 0 ]; then \
      echo "sol-pi load probe: $n extension_error event(s) — the extension would run INERT with the build green:"; \
      cat /tmp/pi-solpi-load.log; exit 1; \
    fi
# settings.json is a single in-tree source too (extensions/sol-pi/settings.json):
# defaultProjectTrust=never gates the workspaces pi treats as trust-requiring,
# and pi-searxng rides the same file. (r6: `projectTrusted` is NOT a pi
# settings key — deleted; the control that actually holds is --no-approve —
# pi documents it as the run-level OVERRIDE of project trust, the twin of
# --approve — which buildPiArgs emits on every invocation, enforced by
# TestPiArgsAlwaysCarryNoApprove and the trust gate above.)
COPY extensions/sol-pi.trust-probe.mjs /extensions/sol-pi.trust-probe.mjs
RUN set -e; \
    mkdir -p /tmp/hostile-ws/.pi \
    && printf '%s\n' '{"version":1,"actionFusion":false,"observationPack":false,"evidencePreservingReducer":true,"onlineContextCompact":false,"cacheWriteReadRatio":12.5}' > /tmp/hostile-ws/.pi/sol-pi.json \
    && cd /tmp/hostile-ws; \
    rc=0; \
    PI_SKIP_VERSION_CHECK=1 timeout 60 pi --no-approve -e /extensions/sol-pi -e /extensions/sol-pi.trust-probe.mjs --mode rpc </dev/null >/tmp/pi-solpi-arm1.log 2>&1 || rc=$?; \
    grep -q sol_pi_trust_probe /tmp/pi-solpi-arm1.log || { echo "sol-pi trust gate arm1: probe line missing (pi rc=$rc)"; cat /tmp/pi-solpi-arm1.log; exit 1; }; \
    node -e 'const l=require("fs").readFileSync("/tmp/pi-solpi-arm1.log","utf8").split("\n").find(l=>l.includes("sol_pi_trust_probe"));const e=JSON.parse(l);if(e.error){console.error("trust probe errored:",e.error);process.exit(1)}if(e.reducer!==false||e.actionFusion!==true){console.error("ARM1 FAIL: --no-approve must yield the shipped profile, got",l);process.exit(1)}' || { echo "sol-pi trust gate arm1 assertion failed"; cat /tmp/pi-solpi-arm1.log; exit 1; }; \
    rc=0; \
    PI_SKIP_VERSION_CHECK=1 timeout 60 pi -e /extensions/sol-pi -e /extensions/sol-pi.trust-probe.mjs --mode rpc </dev/null >/tmp/pi-solpi-arm2.log 2>&1 || rc=$?; \
    grep -q sol_pi_trust_probe /tmp/pi-solpi-arm2.log || { echo "sol-pi trust gate arm2: probe line missing (pi rc=$rc)"; cat /tmp/pi-solpi-arm2.log; exit 1; }; \
    node -e 'const l=require("fs").readFileSync("/tmp/pi-solpi-arm2.log","utf8").split("\n").find(l=>l.includes("sol_pi_trust_probe"));const e=JSON.parse(l);if(e.error){console.error("trust probe errored:",e.error);process.exit(1)}if(e.trusted!==true||e.reducer!==true){console.error("ARM2 FAIL: the auto-trust class must be visible (probe sensitivity), got",l);process.exit(1)}' || { echo "sol-pi trust gate arm2 assertion failed"; cat /tmp/pi-solpi-arm2.log; exit 1; }

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/harmostes-worker"]
